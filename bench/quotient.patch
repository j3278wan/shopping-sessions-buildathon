+// Choose an optional compact representation from actual first fields.
+int event_prefix(const std::vector<Text>& files) {
+    std::array<unsigned,256> counts{};
+    unsigned sample=0;
+    for(Text file:files) {
+        Text body=after_header(file);
+        while(!body.empty() && sample<256) {
+            auto stop=body.find('\n');
+            auto line=body.substr(0,stop);
+            body.remove_prefix(stop==Text::npos?body.size():stop+1);
+            std::array<Text,7> f;
+            if(split_fields(line,f) && !f[0].empty()) {
+                ++sample;
+                if(f[0].size()==9) ++counts[static_cast<unsigned char>(f[0][0])];
+            }
+        }
+        if(sample==256)break;
+    }
+    const auto best=std::max_element(counts.begin(),counts.end());
+    return *best ? static_cast<int>(best-counts.begin()) : -1;
+}
+struct EventId {
+    static constexpr uint64_t external=UINT64_C(1)<<63;
+    uint64_t bits=0;
+    EventId()=default;
+    EventId(Text text,int prefix) {
+        if(text.size()==9 && static_cast<unsigned char>(text[0])==prefix) {
+            uint64_t word;
+            std::memcpy(&word,text.data()+1,8);
+            if(!(word&UINT64_C(0x8080808080808080))) {
+#if __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+                word=__builtin_bswap64(word);
+#endif
+#if defined(__BMI2__)
+                word=_pext_u64(word,UINT64_C(0x7f7f7f7f7f7f7f7f));
+#else
+                word=(word&UINT64_C(0x007f007f007f007f))|((word>>1)&UINT64_C(0x3f803f803f803f80));
+                word=(word&UINT64_C(0x00003fff00003fff))|((word>>2)&UINT64_C(0x0fffc0000fffc000));
+                word=(word&UINT64_C(0x000000000fffffff))|((word>>4)&UINT64_C(0x00fffffff0000000));
+#endif
+                // Every operation is invertible on the 56-bit domain.
+                word^=word>>27;
+                word=(word*UINT64_C(0xbf58476d1ce4e5b9))&((UINT64_C(1)<<56)-1);
+                bits=word^(word>>25);
+                return;
+            }
+        }
+        bits=external|reinterpret_cast<uintptr_t>(text.data());
+    }
+    Text text() const {
+        const char* p=reinterpret_cast<const char*>(static_cast<uintptr_t>(bits&~external));
+        auto end=p;
+        while(*end!=',' && *end!='"')++end;
+        return {p,static_cast<size_t>(end-p)};
+    }
+    size_t hash() const { return bits & external ? std::hash<Text>{}(text()) : bits; }
+    bool operator==(const EventId& b) const {
+        return bits==b.bits || ((bits&b.bits&external) && text()==b.text());
+    }
+};
+struct EventHash{size_t operator()(const EventId& id)const{return id.hash();}};
