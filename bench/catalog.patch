+// A canonical decimal suffix indexes a dense catalog directly. All alternate
+// spellings, sparse tails, and arbitrary identifiers keep a byte-exact index.
+class CatalogIndex {
+    Index<> general;
+    Text prefix;
+    bool initialized=false;
+    std::vector<uint32_t> dense;
+    std::vector<std::pair<Text,uint32_t>> entries;
+    uint32_t suffix(Text key) const {
+        if(key.size()<=prefix.size() || key.size()-prefix.size()>8 ||
+           key.substr(0,prefix.size())!=prefix)return NONE;
+        const char* first=key.data()+prefix.size();
+        if(*first=='0' && first+1!=key.data()+key.size())return NONE;
+        uint32_t v;
+        const auto read=std::from_chars(first,key.data()+key.size(),v);
+        return read.ec==std::errc{} && read.ptr==key.data()+key.size() ? v : NONE;
+    }
+  public:
+    template<class Factory> void add(Text key,Factory factory) {
+        if(!initialized) {
+            auto pos=key.size();
+            while(pos && key[pos-1]>='0' && key[pos-1]<='9')--pos;
+            prefix=key.substr(0,pos);
+            initialized=true;
+        }
+        entries.emplace_back(key,factory());
+    }
+    void finish() {
+        const size_t max_range=std::min<size_t>(entries.size()*4+16,1u<<23);
+        size_t n=0;
+        for(auto [key,value]:entries){auto i=suffix(key);if(i<max_range)n=std::max(n,size_t(i)+1);}
+        dense.resize(n,NONE);
+        for(auto [key,value]:entries) {
+            auto i=suffix(key);
+            if(i<dense.size())dense[i]=value;
+            else general.add(key,[=]{return value;});
+        }
+        std::vector<std::pair<Text,uint32_t>>().swap(entries);
+    }
+    const uint32_t* find(Text key) const {
+        auto i=suffix(key);
+        if(i<dense.size())return dense[i]==NONE ? nullptr : &dense[i];
+        return general.find(key);
+    }
+};
